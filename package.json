{
  "name": "threadpack",
  "version": "1.7.0",
  "description": "Local tools for Codex, Claude Code, ChatGPT and Claude exports: import ZIPs, clean, read Markdown, extract code, and export portable context bundles.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://hajimi1214.github.io/ThreadPack/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hajimi1214/ThreadPack.git"
  },
  "bugs": {
    "url": "https://github.com/hajimi1214/ThreadPack/issues"
  },
  "keywords": [
    "ai",
    "codex",
    "claude-code",
    "chatgpt",
    "offline",
    "conversation",
    "redaction",
    "handoff",
    "code-extraction",
    "code-highlighting",
    "zip-export",
    "offline-first",
    "jsonl",
    "context-management",
    "pwa"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "threadpack": "dist-cli/threadpack.mjs"
  },
  "files": [
    "dist-cli",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:cli",
    "build:web": "tsc --noEmit && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "highlight.js": "11.11.1",
    "lowlight": "3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
